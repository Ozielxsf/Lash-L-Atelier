# Lash L'Atelier — environment variables.
#
# Phase 1 (this public site) needs NONE of these: it is fully static.
# They switch on with the roadmap — online booking, the admin dashboard,
# then product ordering. Set them in Vercel, never commit real values.

# Canonical site URL (used for metadata, sitemap, JSON-LD). Defaults to
# https://lashlatelier.com in src/config/site.config.ts.
# NEXT_PUBLIC_SITE_URL=

# ── Booking + admin (phase 2 — built; the owner switches it on in /admin) ──
# Supabase — one isolated project for this client (Wallink account, East US).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=          # server-only. Never NEXT_PUBLIC_.
# SUPABASE_SCHEMA=                  # only if tables live outside "public"

# Admin sign-in at /admin (iron-session). SESSION_SECRET must be 32+ chars.
# Generate: openssl rand -base64 32
SESSION_SECRET=
ADMIN_PASSWORD=

# Resend — booking confirmations. Verify the client's sending domain
# (SPF/DKIM/DMARC) before launch; never ship onboarding@resend.dev.
RESEND_API_KEY=
# Sender for booking emails — an address on the client's VERIFIED domain,
# e.g. bookings@lashlatelier.com. Unset = emails are skipped (and logged).
BOOKING_FROM_EMAIL=

# Cloudflare Turnstile — required on every public form. verifyTurnstile()
# fails CLOSED, so an unset secret rejects every submission.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis via the Vercel integration — durable rate limiting.
# Without these the limiter falls back to memory, which is useless on serverless.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Shop (phase 3) ───────────────────────────────────────────────────────
# Square or Stripe — hosted checkout only; we never touch card data.
